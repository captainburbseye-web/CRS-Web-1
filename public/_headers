# Cloudflare Pages cache headers — v5.18 performance pass
# Hashed assets (Vite content-hash filenames) — immutable, 1 year
/static/assets/*
  Cache-Control: public, max-age=31536000, immutable

# WebP images — 30 days
/static/*.webp
  Cache-Control: public, max-age=2592000
/static/rack-images/*.webp
  Cache-Control: public, max-age=2592000
/assets/*.webp
  Cache-Control: public, max-age=2592000

# JPEG/PNG originals — 30 days
/static/*.png
  Cache-Control: public, max-age=2592000
/static/*.jpg
  Cache-Control: public, max-age=2592000
/static/rack-images/*.jpg
  Cache-Control: public, max-age=2592000
/static/rack-images/*.png
  Cache-Control: public, max-age=2592000
/assets/*.png
  Cache-Control: public, max-age=2592000

# CSS files — 7 days (not hashed, can be updated)
/static/*.css
  Cache-Control: public, max-age=604800

# Static JS utilities — 7 days
/static/*.js
  Cache-Control: public, max-age=604800

# Videos — 30 days
/static/workshop-cafe-assets/*.mp4
  Cache-Control: public, max-age=2592000

# Fonts (served via Google CDN — handled by them)
# HTML pages — no cache (always fresh)
/
  Cache-Control: no-cache, must-revalidate
/*.html
  Cache-Control: no-cache, must-revalidate
