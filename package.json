{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:critical": "node scripts/extract-critical-css.js && node scripts/build.mjs",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy dist --project-name crs-web-1",
    "deploy:optimized": "npm run build:critical && wrangler pages deploy dist --project-name crs-web-1",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "perf:test": "node scripts/extract-critical-css.js",
    "perf:monitor": "echo 'Open browser console to see performance metrics'"
  },
  "dependencies": {
    "gsap": "^3.14.2",
    "hono": "^4.11.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "swiper": "^12.1.2"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.23",
    "cssnano": "^7.1.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
